CREATE DATABASE IF NOT EXISTS FRAUD_DETECTION_DB;
CREATE SCHEMA IF NOT EXISTS FRAUD_DETECTION_DB.RAW;
CREATE SCHEMA IF NOT EXISTS FRAUD_DETECTION_DB.STAGING;
CREATE SCHEMA IF NOT EXISTS FRAUD_DETECTION_DB.CORE;
CREATE SCHEMA IF NOT EXISTS FRAUD_DETECTION_DB.REPORTING;

CREATE STAGE IF NOT EXISTS FRAUD_DETECTION_DB.RAW.TRANSACTIONS_STAGE;
SHOW STAGES IN SCHEMA FRAUD_DETECTION_DB.RAW;

USE DATABASE FRAUD_DETECTION_DB;
USE SCHEMA FRAUD_DETECTION_DB.RAW;

CREATE TABLE IF NOT EXISTS FRAUD_DETECTION_DB.RAW.TRANSACTIONS (
    transaction_id   STRING,
    transaction_date TIMESTAMP_NTZ,
    customer_id      STRING,
    merchant_name    STRING,
    category         STRING,
    amount           FLOAT,
    is_fraud_actual  INT,
    customer_lat     FLOAT,
    customer_long    FLOAT,
    merchant_lat     FLOAT,
    merchant_long    FLOAT,
    is_outlier       BOOLEAN
);

CREATE TABLE IF NOT EXISTS FRAUD_DETECTION_DB.RAW.TRANSACTIONS_QUARANTINE
LIKE FRAUD_DETECTION_DB.RAW.TRANSACTIONS;

SHOW WAREHOUSES;

SELECT COUNT(*) FROM FRAUD_DETECTION_DB.RAW.TRANSACTIONS
WHERE transaction_date < '2019-01-01' OR transaction_date >= '2020-06-22';

SELECT (SELECT COUNT(*) FROM FRAUD_DETECTION_DB.RAW.TRANSACTIONS)            AS clean_rows,
       (SELECT COUNT(*) FROM FRAUD_DETECTION_DB.RAW.TRANSACTIONS_QUARANTINE) AS quarantine_rows,
       (SELECT MAX(transaction_date) FROM FRAUD_DETECTION_DB.RAW.TRANSACTIONS) AS latest_date;

CREATE OR REPLACE DYNAMIC TABLE FRAUD_DETECTION_DB.CORE.CUSTOMER_ROLLING_STATS
  TARGET_LAG = '5 minutes'
  WAREHOUSE = COMPUTE_WH
AS
SELECT
    customer_id,
    COUNT(*)            AS txn_count,
    SUM(amount)         AS total_spend,
    AVG(amount)         AS avg_spend,
    MAX(transaction_date) AS last_txn_date
FROM FRAUD_DETECTION_DB.CORE.FCT_TRANSACTIONS
GROUP BY customer_id;

SELECT * FROM FRAUD_DETECTION_DB.CORE.CUSTOMER_ROLLING_STATS LIMIT 10;

DESCRIBE TABLE FRAUD_DETECTION_DB.CORE.FCT_TRANSACTIONS;

CREATE OR REPLACE VIEW FRAUD_DETECTION_DB.REPORTING.FRAUD_SUMMARY AS
SELECT
    DATE_TRUNC('day', TRANSACTION_DATE) AS TXN_DATE,
    CATEGORY,
    MERCHANT_KEY,
    COUNT(*) AS TXN_COUNT,
    SUM(AMOUNT) AS TOTAL_AMOUNT,
    SUM(CASE WHEN FRAUD_RISK_SCORE >= 1 THEN 1 ELSE 0 END) AS FLAGGED_COUNT
FROM FRAUD_DETECTION_DB.REPORTING.FRAUD_SCORES
GROUP BY 1, 2, 3;

SELECT * FROM FRAUD_DETECTION_DB.REPORTING.FRAUD_SUMMARY ORDER BY FLAGGED_COUNT DESC LIMIT 10;

SELECT GET_DDL('TABLE', 'REPORTING.FRAUD_SCORES');
SELECT GET_DDL('VIEW',  'REPORTING.FRAUD_SUMMARY');

SELECT * FROM FRAUD_DETECTION_DB.REPORTING.FRAUD_SCORES LIMIT 5;

SHOW TABLES IN SCHEMA FRAUD_DETECTION_DB.REPORTING;
SHOW VIEWS  IN SCHEMA FRAUD_DETECTION_DB.REPORTING;

SELECT FRAUD_RISK_SCORE,
       COUNT(*) AS TXNS,
       SUM(IS_FRAUD_ACTUAL) AS ACTUAL_FRAUD,
       ROUND(100 * SUM(IS_FRAUD_ACTUAL) / COUNT(*), 2) AS FRAUD_RATE_PCT
FROM FRAUD_DETECTION_DB.REPORTING.FRAUD_SCORES
GROUP BY 1 ORDER BY 1;

SELECT GET_DDL('DYNAMIC_TABLE', 'FRAUD_DETECTION_DB.CORE.CUSTOMER_ROLLING_STATS');
SELECT GET_DDL('VIEW', 'FRAUD_DETECTION_DB.REPORTING.FRAUD_SUMMARY');

SHOW DYNAMIC TABLES IN DATABASE FRAUD_DETECTION_DB;
